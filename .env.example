# Telegram Bot Token (from @BotFather)
TG_TOKEN=your_telegram_bot_token

# GCP VM details
GCP_IP=your_gcp_vm_ip
GCP_USER=ubuntu
GCP_PORT=22

# SSH private key (base64-encoded)
# Generate with: cat ~/.ssh/id_rsa | base64 -w 0
SSH_PRIVATE_KEY_B64=your_base64_encoded_ssh_key

# Comma-separated Telegram chat IDs allowed to use the bot (empty = no restriction)
ALLOWED_CHAT_IDS=

# Path to QA worker script on GCP VM
QA_WORKER_SCRIPT=/home/ubuntu/qa_worker.sh

# Timeouts (seconds)
SSH_TIMEOUT=30
COMMAND_TIMEOUT=600

# Containerized IAP test settings
DOCKER_IMAGE=qa-avd-golden:latest
QA_DATA_VOLUME=/mnt/qa-data
TARGET_PACKAGE=com.yourcompany.app
TARGET_APK_PATH=/mnt/qa-data/app-staging.apk
IAP_TEST_TIMEOUT=900
